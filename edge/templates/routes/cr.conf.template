# Comptes rendus sous /cr/ : préfixe conservé, le module le retire lui-même.

location = /cr {
    set $edge_module cr;
    return 308 /cr/;
}

location /cr/ {
    set $edge_module cr;
    client_max_body_size 25m;
    include /etc/nginx/snippets/proxy-commun.conf;
    proxy_set_header Host $http_host;
    # URL vue des navigateurs, posée par le bloc server (publique ou LAN).
    proxy_set_header X-Forwarded-Proto $edge_fwd_proto;
    proxy_set_header X-Forwarded-Host $edge_fwd_host;
    proxy_set_header X-Forwarded-Port $edge_fwd_port;
    proxy_set_header X-Forwarded-Prefix /cr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    # Cookies confinés au préfixe, quel que soit le code du module.
    proxy_cookie_path ~^(?!/cr(?:/|$))/?(.*)$ /cr/$1;
    proxy_read_timeout 300s;
    proxy_send_timeout 300s;
    # Un 502/503/504 renvoyé par le module (sa propre passerelle) : page d'attente.
    proxy_intercept_errors on;
    proxy_pass http://${EDGE_CR_UPSTREAM};
}
