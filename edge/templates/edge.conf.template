# HSTS seulement si l'URL publique est en https (zrok termine TLS). Aucune
# extension aux sous-domaines : le domaine parent ne nous appartient pas.
map "${EDGE_PUBLIC_PROTO}" $edge_hsts {
    https   "max-age=31536000";
    default "";
}

map $http_upgrade $edge_connection {
    default upgrade;
    ""      "";
}

server {
    listen ${EDGE_LISTEN};
    server_name _;

    # Redirections de nginx relatives : jamais l'adresse interne de la passerelle.
    absolute_redirect off;

    # La passerelle ne pose que l'en-tête de plateforme. CSP, X-Frame-Options…
    # restent aux modules : les doubler casserait leurs exceptions.
    add_header Strict-Transport-Security $edge_hsts always;

    set $edge_module edge;

    # Module arrêté ou en mise à jour : page d'attente au lieu d'un 502 brut.
    include /etc/nginx/snippets/attente.conf;

    # URL vue des navigateurs, annoncée aux modules servis sous préfixe.
    set $edge_fwd_proto ${EDGE_PUBLIC_PROTO};
    set $edge_fwd_host  ${EDGE_PUBLIC_HOST};
    set $edge_fwd_port  ${EDGE_PUBLIC_PORT};

    # Modules actifs (fichier présent seulement si leur adresse est renseignée).
    include /tmp/conf.d/routes/*.conf;

    include /tmp/conf.d/racine/needs.conf;
}

# Écoutes directes du LAN (EDGE_LAN), une application par port : lan.conf,
# écrit au démarrage par 26-ecoutes-lan.sh.
