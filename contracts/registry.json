{
  "label_namespace": "org.cfao",
  "modules": {
    "cfao-academy-mail": {
      "dockerfile": "cfao-academy-mail/Dockerfile",
      "images": []
    },
    "cfao-core": {
      "dockerfile": "cfao-core/Dockerfile",
      "images": []
    },
    "cfao-needs": {
      "dockerfile": "cfao-needs/api/Dockerfile",
      "images": ["antifragile237/cfao-needs-api"]
    },
    "cfao-planning": {
      "dockerfile": "cfao-planning/api/Dockerfile",
      "images": []
    }
  },
  "contracts": [
    {
      "id": "mail-outbound",
      "provider": "cfao-academy-mail",
      "format": "openapi",
      "spec": "cfao-academy-mail/api/outbound/contract/mail.openapi.json",
      "consumers": []
    },
    {
      "id": "needs-analytics",
      "provider": "cfao-needs",
      "format": "openapi",
      "spec": "cfao-needs/api/analytics/contract/needs-analytics.openapi.json",
      "consumers": [
        {
          "module": "cfao-core",
          "range": "^1",
          "client_files": ["cfao-core/analytics/services.py"],
          "tests": ["cfao-core/analytics/tests/test_needs_analytics_consumer.py"]
        },
        {
          "module": "cfao-planning",
          "range": "^1.3",
          "client_files": ["cfao-planning/api/planning/clients/needs.py"],
          "tests": ["cfao-planning/api/planning/tests/test_needs_consumer.py"]
        }
      ]
    }
  ]
}
