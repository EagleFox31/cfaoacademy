{
  "openapi": "3.1.0",
  "info": {
    "title": "CFAO Academy Mail",
    "version": "0.1.0",
    "description": "Hub d'envoi. Les modules passent le contexte et l'adresse du bouton. Un champ requis manquant est refusé (400), le mail n'est pas envoyé."
  },
  "paths": {
    "/api/v1/mail/healthz": {
      "get": {
        "operationId": "healthz",
        "security": [],
        "responses": {
          "200": {
            "description": "Sonde.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/mail/contract": {
      "get": {
        "operationId": "contract",
        "security": [],
        "responses": {
          "200": {
            "description": "Ce document OpenAPI."
          }
        }
      }
    },
    "/api/v1/mail/messages/enqueue": {
      "post": {
        "operationId": "enqueue",
        "security": [
          {
            "serviceKey": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "oneOf": [
                  {
                    "$ref": "#/components/schemas/EnqueueNeedsSubmissionConfirmed"
                  },
                  {
                    "$ref": "#/components/schemas/EnqueueNeedsCampaignOpened"
                  },
                  {
                    "$ref": "#/components/schemas/EnqueueNeedsInternalSubmissionSummary"
                  },
                  {
                    "$ref": "#/components/schemas/EnqueueRapportsCrToDocument"
                  },
                  {
                    "$ref": "#/components/schemas/EnqueueRapportsCrStepsMissing"
                  },
                  {
                    "$ref": "#/components/schemas/EnqueueRapportsCrDraftStale"
                  },
                  {
                    "$ref": "#/components/schemas/EnqueueCoreSessionReminder"
                  },
                  {
                    "$ref": "#/components/schemas/EnqueueOpsTicketResolved"
                  },
                  {
                    "$ref": "#/components/schemas/EnqueueDeliveryWeeklyDevReminder"
                  }
                ]
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Message créé.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EnqueueResponse"
                }
              }
            }
          },
          "200": {
            "description": "Déjà en file (correlation_id).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EnqueueResponse"
                }
              }
            }
          },
          "400": {
            "description": "Type inconnu ou champs requis manquants.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Clé X-Mail-Service-Key absente ou invalide.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "serviceKey": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Mail-Service-Key"
      }
    },
