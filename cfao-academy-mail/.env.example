MAIL_SECRET_KEY=change-me-dev-only
MAIL_INBOUND_KEY=change-me-inbound-dev
DB_PASSWORD=mail_dev
DB_NAME=cfao_mail
DB_USER=cfao_mail
API_PORT=5180
MAIL_EMAIL_BACKEND=smtp
MAIL_EMAIL_FROM=CFAO Academy <helpdeskcm@cfao.com>
MAIL_SMTP_HOST=smtp.cfao.corp
MAIL_SMTP_PORT=25
MAIL_SMTP_USE_TLS=false
MAIL_SMTP_TIMEOUT=15
MAIL_INTERNAL_DOMAINS=cfao.com,cfaoacademy.com
# URL publique de la plateforme. Vide = calculée par deploy.ps1 (http://<IP LAN>:<MAIL_PUBLIC_PORT>).
# Son hôte est toujours autorisé pour le bouton du mail.
MAIL_PUBLIC_BASE_URL=
# Port d'accès à la plateforme, fixé par l'hébergement (aucune valeur supposée par le script).
MAIL_PUBLIC_PORT=8080
# Hôtes supplémentaires (https seulement), séparés par des virgules.
# Les deux vides = tout lien refusé (sauf DJANGO_DEBUG=true).
MAIL_ALLOWED_LINK_HOSTS=
DEPLOYMENT_MODE=standalone
