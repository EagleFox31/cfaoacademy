MAIL_SECRET_KEY=change-me-dev-only
MAIL_INBOUND_KEY=change-me-inbound-dev
# Clés liées à une source : source=clé,source2=clé2. Une clé liée impose son source_app ;
# les messages sensibles (codes, liens de connexion) n'acceptent que ces clés.
# Les messages identity.* (Keycloak) exigent la source cfao-identity, ex. : cfao-identity=<clé longue>
MAIL_INBOUND_KEYS=
# Clé Fernet des secrets des messages sensibles. Vide = messages sensibles refusés.
# Générer : python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# La perdre ou la changer rend illisibles les messages encore en file (ils échouent, sans fuite).
MAIL_SEALED_CONTEXT_KEY=
MAIL_SENSITIVE_MAX_TTL_MINUTES=1440
DB_PASSWORD=mail_dev
DB_NAME=cfao_mail
DB_USER=cfao_mail
API_PORT=5180
MAIL_EMAIL_BACKEND=smtp
MAIL_EMAIL_FROM=CFAO Academy <helpdeskcm@cfao.com>
MAIL_SMTP_HOST=smtp.cfao.corp
MAIL_SMTP_PORT=25
MAIL_SMTP_USE_TLS=false
MAIL_SMTP_TIMEOUT=15
MAIL_INTERNAL_DOMAINS=cfao.com,cfaoacademy.com
# Hôtes autorisés pour le bouton du mail. Vide = tout lien refusé (sauf DJANGO_DEBUG=true).
# Y mettre aussi l'hôte public de Keycloak (KC_HOSTNAME) : ses liens de connexion et de mot de passe en dépendent.
# Hors DEBUG, seuls les liens https passent : la recette locale (http://localhost:8088) demande
# MAIL_ALLOWED_LINK_HOSTS=localhost et DJANGO_DEBUG=true, jamais en prod.
MAIL_ALLOWED_LINK_HOSTS=academy.cfao.com
DEPLOYMENT_MODE=standalone
