# Modèle du .env de /srv/apps/cfao-core (fichier réel en 600, hors dépôt).
# Secrets : `openssl rand -base64 48`, générés sur le serveur.
CORE_VERSION=v0.1.0
CORE_DB_PASSWORD=
CORE_SECRET_KEY=
CORE_ALLOWED_HOSTS=academy-portail.shares.zrok.io,academy-server.shares.zrok.io,localhost,127.0.0.1,core-api
OIDC_ISSUER=https://academy-server.shares.zrok.io/auth/realms/cfao
# Même valeur que NEEDS_ANALYTICS_INBOUND_KEY dans le .env de cfao-needs.
NEEDS_ANALYTICS_KEY=
# Vide : base MEDACAP injoignable depuis le serveur (indicateurs MEDACAP vides).
MEDACAP_MONGO_URI=
