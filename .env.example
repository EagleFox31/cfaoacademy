# CFAO Academy — variables d'environnement (FORME uniquement, aucun secret réel).
# Copier en `.env` pour le dev local. En prod : Azure Key Vault + Managed Identity (architecture.md §8).

# ── Keycloak ──
OIDC_REALM=cfao
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change-me
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=change-me

# ── core (Django) ──
DJANGO_SECRET_KEY=dev-only-change-me
DJANGO_DEBUG=1
CORE_DB_NAME=core
CORE_DB_USER=core
CORE_DB_PASSWORD=change-me
# Audience attendue dans le JWT (client Keycloak du portail). Vide = pas de vérif d'audience (dev).
OIDC_AUDIENCE=

# ── operations (Node) ──
OPS_DB_NAME=ops
OPS_DB_USER=ops
OPS_DB_PASSWORD=change-me

# ── BFF oauth2-proxy (à activer plus tard) ──
OAUTH2_PROXY_CLIENT_ID=cfao-portal
OAUTH2_PROXY_CLIENT_SECRET=change-me
# Générer : openssl rand -base64 32
OAUTH2_PROXY_COOKIE_SECRET=generate-32-bytes-base64

# ── Identity providers upstream (00-6, désactivés tant que vides) ──
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MS_CLIENT_ID=
MS_CLIENT_SECRET=

# ── Limites de ressources des conteneurs (défauts dev ; cf. docker-compose.yml) ──
# Surcharger par environnement (CPU en vCPU, mémoire ex. 512M / 1G).
# En PROD (Azure Container Apps) : le dimensionnement vit dans l'IaC, pas ici.
CPU_KEYCLOAK=1.0
MEM_KEYCLOAK=768M
MEM_KEYCLOAK_RES=384M
CPU_KEYCLOAK_DB=0.40
MEM_KEYCLOAK_DB=256M
CPU_KCCONFIG=0.50
MEM_KCCONFIG=512M
CPU_CERBOS=0.50
MEM_CERBOS=192M
CPU_CORE=0.75
MEM_CORE=512M
CPU_CORE_DB=0.40
MEM_CORE_DB=256M
CPU_OPS=0.50
MEM_OPS=256M
CPU_OPS_DB=0.40
MEM_OPS_DB=256M
CPU_GATEWAY=0.25
MEM_GATEWAY=64M
