# Modèle du .env de /srv/apps/cfao-identity (fichier réel en 600, hors dépôt).
# Secrets : `openssl rand -base64 24`.
KC_VERSION=v0.1.0
KC_PORT=8083
# URL publique de Keycloak, telle que la voient navigateurs et modules (émetteur `iss`).
KC_HOSTNAME=http://192.168.10.155:8083
KC_ADMIN=admin
KC_ADMIN_PASSWORD=
KC_DB_PASSWORD=
# Identique à OAUTH2_PROXY_CLIENT_SECRET du portail.
CFAO_PORTAL_SECRET=
