# Modèle du .env de /srv/apps/cfao-identity (fichier réel en 600, hors dépôt).
# Secrets : `openssl rand -base64 24`.
# Aucun hôte n'est codé dans l'image ni dans le realm : tout vient d'ici.
# Appliquer un changement : `up -d keycloak` puis `run --rm config` (idempotent).
KC_VERSION=v0.2.0
KC_PORT=8083
# URL publique canonique (émetteur `iss`). Préférer un nom DNS stable à une IP :
# l'infrastructure derrière peut alors changer sans toucher aux jetons.
KC_HOSTNAME=http://192.168.10.155:8083
KC_ADMIN=admin
KC_ADMIN_PASSWORD=
KC_DB_PASSWORD=
# Identique à OAUTH2_PROXY_CLIENT_SECRET du portail.
CFAO_PORTAL_SECRET=
# Redirections autorisées, en liste JSON (plusieurs hôtes possibles).
CFAO_PORTAL_REDIRECT_URIS=["http://192.168.10.155:8000/oauth2/callback"]
CFAO_NEEDS_REDIRECT_URIS=["http://192.168.10.155:8082/*"]

# Changer d'hôte sans rupture (ancien et nouveau coexistent) :
# 1. ajouter le nouvel hôte aux listes ci-dessus, puis `run --rm config` ;
# 2. dans chaque module, ajouter le nouvel émetteur à OIDC_TRUSTED_ISSUERS
#    en gardant l'ancien ;
# 3. changer KC_HOSTNAME, puis `up -d keycloak` ;
# 4. une fois les anciennes sessions expirées (8 h au plus), retirer l'ancien
#    hôte des listes et des modules.
