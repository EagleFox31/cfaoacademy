# Modèle du .env de /srv/apps/cfao-identity (fichier réel en 600, hors dépôt).
# Secrets : `openssl rand -base64 24`.
# Aucun hôte n'est codé dans l'image ni dans le realm : tout vient d'ici.
# Appliquer un changement : `up -d keycloak` puis `run --rm config` (idempotent).
KC_VERSION=v0.3.0
# Keycloak n'écoute qu'en local : la passerelle commune (cfao-edge) le publie.
KC_BIND=127.0.0.1
KC_PORT=8083
# URL publique canonique (émetteur `iss`), servie par la passerelle sous /auth.
# Préférer un nom DNS stable à une IP : l'infrastructure derrière peut alors
# changer sans toucher aux jetons.
KC_HOSTNAME=https://academy-server.shares.zrok.io/auth
# Console d'administration seulement par tunnel :
#   ssh -L 8083:127.0.0.1:8083 cfao-serveur
KC_HOSTNAME_ADMIN=http://localhost:8083/auth
KC_ADMIN=admin
KC_ADMIN_PASSWORD=
KC_DB_PASSWORD=
# Identique à OAUTH2_PROXY_CLIENT_SECRET du portail.
CFAO_PORTAL_SECRET=
# Redirections autorisées, en liste JSON (plusieurs hôtes possibles).
# `[]` : client sans redirection, donc inutilisable (portail pas encore déployé).
CFAO_PORTAL_REDIRECT_URIS=[]
# needs : URI exactes, rappel et racine (retour de déconnexion), par entrée
# (zrok, puis écoute LAN de cfao-edge). Jamais de joker `*`.
CFAO_NEEDS_REDIRECT_URIS=["https://academy-server.shares.zrok.io/callback","https://academy-server.shares.zrok.io/","http://192.168.10.155:8080/callback","http://192.168.10.155:8080/"]

# Valeurs côté modules :
#   OIDC_ISSUER=<KC_HOSTNAME>/realms/cfao
#   OIDC_JWKS_URL=http://keycloak:8080/auth/realms/cfao/protocol/openid-connect/certs
#   (réseau cfao-identity_default, rejoint par l'API du module)

# Changer d'hôte sans rupture (ancien et nouveau coexistent) :
# 1. ajouter le nouvel hôte aux listes ci-dessus, puis `run --rm config` ;
# 2. dans chaque module, ajouter le nouvel émetteur à OIDC_TRUSTED_ISSUERS
#    en gardant l'ancien ;
# 3. changer KC_HOSTNAME, puis `up -d keycloak` ;
# 4. une fois les anciennes sessions expirées (8 h au plus), retirer l'ancien
#    hôte des listes et des modules.
