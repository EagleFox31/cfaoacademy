{
  "components": {
    "schemas": {
      "AllocationsPerBranch": {
        "examples": [
          {
            "allocations": [
              {
                "country": "TOGO",
                "seats": 264
              }
            ],
            "year": 2026
          }
        ],
        "properties": {
          "allocations": {
            "items": {
              "properties": {
                "country": {
                  "type": "string"
                },
                "seats": {
                  "minimum": 0,
                  "type": "integer"
                }
              },
              "required": [
                "country",
                "seats"
              ],
              "type": "object"
            },
            "type": "array"
          },
          "year": {
            "type": "integer"
          }
        },
        "required": [
          "year",
          "allocations"
        ],
        "type": "object"
      },
      "CatalogLevelResult": {
        "examples": [
          {
            "changed": true,
            "level_label": "G3",
            "tier": "SENIOR"
          }
        ],
        "properties": {
          "changed": {
            "type": "boolean"
          },
          "level_label": {
            "type": "string"
          },
          "tier": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "changed",
          "level_label",
          "tier"
        ],
        "type": "object"
      },
      "CatalogLevelUpdate": {
        "properties": {
          "expected": {
            "type": "string"
          },
          "level_label": {
            "type": "string"
          },
          "line_ids": {
            "items": {
              "format": "uuid",
              "type": "string"
            },
            "type": "array"
          }
        },
        "required": [
          "line_ids",
          "expected",
          "level_label"
        ],
        "type": "object"
      },
      "CatalogLevels": {
        "examples": [
          {
            "catalog_available": true,
            "lines": [
              {
                "brand": "TOYOTA",
                "code": "TS01-G4",
                "id": "6f1c1a4e-0b7a-4b52-9d39-3a3f7f1d2c10",
                "level_label": "G4",
                "sort_order": 40,
                "tier": "JUNIOR"
              }
            ],
            "year": 2027
          }
        ],
        "properties": {
          "catalog_available": {
            "type": "boolean"
          },
          "lines": {
            "items": {
              "properties": {
                "brand": {
                  "type": "string"
                },
                "code": {
                  "type": "string"
                },
                "id": {
                  "format": "uuid",
                  "type": "string"
                },
                "level_label": {
                  "type": "string"
                },
                "sort_order": {
                  "type": "integer"
                },
                "tier": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              },
              "required": [
                "id",
                "brand",
                "code",
                "level_label",
                "tier",
                "sort_order"
              ],
              "type": "object"
            },
            "type": "array"
          },
          "year": {
            "type": "integer"
          }
        },
        "required": [
          "year",
          "catalog_available",
          "lines"
        ],
        "type": "object"
      },
      "Error": {
        "properties": {
          "detail": {
            "type": "string"
          }
        },
        "required": [
          "detail"
        ],
        "type": "object"
      },
      "ErrorEnvelope": {
        "properties": {
          "error": {
            "properties": {
              "code": {
                "type": "string"
              },
              "details": {
                "type": "object"
              },
              "message": {
                "type": "string"
              }
            },
            "required": [
              "code",
              "message"
            ],
            "type": "object"
          }
        },
        "required": [
          "error"
        ],
        "type": "object"
      },
      "NeedsByBranchBrand": {
        "examples": [
          {
            "pole": "motors",
            "postponed": [
              {
                "brand": "TOYOTA",
                "code": "TS11-G2",
                "country": "BENIN",
                "places": 3
              }
            ],
            "rows": [
              {
                "brand": "TOYOTA",
                "country": "BENIN",
                "needs": 34,
                "technicians": 22
              }
            ],
            "source": "quota_import",
            "year": 2026
          }
        ],
        "properties": {
          "pole": {
            "enum": [
              "motors",
              "equipment",
              "all"
            ],
            "type": "string"
          },
          "postponed": {
            "description": "Places reportées par module ; elles restent comptées dans `needs`.",
            "items": {
              "properties": {
                "brand": {
                  "type": "string"
                },
                "code": {
                  "type": "string"
                },
                "country": {
                  "type": "string"
                },
                "places": {
                  "minimum": 1,
                  "type": "integer"
                }
              },
              "required": [
                "country",
                "brand",
                "code",
                "places"
              ],
              "type": "object"
            },
            "type": "array"
          },
          "rows": {
            "items": {
              "properties": {
                "brand": {
                  "type": "string"
                },
                "country": {
                  "type": "string"
                },
                "needs": {
                  "minimum": 0,
                  "type": "integer"
                },
                "technicians": {
                  "minimum": 0,
                  "type": [
                    "integer",
                    "null"
                  ]
                }
              },
              "required": [
                "country",
                "brand",
                "needs",
                "technicians"
              ],
              "type": "object"
            },
            "type": "array"
          },
          "source": {
            "enum": [
              "submissions",
              "quota_import",
              "none"
            ],
            "type": "string"
          },
          "year": {
            "type": "integer"
          }
        },
        "required": [
          "year",
          "pole",
          "source",
          "rows"
        ],
        "type": "object"
      },
      "ScheduledTrainings": {
        "examples": [
          {
            "count": 180,
            "year": 2026
          }
        ],
        "properties": {
          "count": {
            "minimum": 0,
            "type": "integer"
          },
          "year": {
            "type": "integer"
          }
        },
        "required": [
          "year",
          "count"
        ],
        "type": "object"
      },
      "TotalTechnicians": {
        "examples": [
          {
            "bu": "equipment",
            "count": 392,
            "year": 2026
          }
        ],
        "properties": {
          "bu": {
            "enum": [
              "equipment",
              "motors",
              "all"
            ],
            "type": "string"
          },
          "count": {
            "minimum": 0,
            "type": "integer"
          },
          "year": {
            "type": "integer"
          }
        },
        "required": [
          "bu",
          "year",
          "count"
        ],
        "type": "object"
      },
      "UnchosenModules": {
        "examples": [
          {
            "catalog_available": true,
            "modules": [
              {
                "brand": "Toyota",
                "code": "TS14-G1",
                "pole": "MOBILITY",
                "tier": "EXPERT",
                "title": "Diagnostic"
              }
            ],
            "pole": "motors",
            "year": 2027
          }
        ],
        "properties": {
          "catalog_available": {
            "type": "boolean"
          },
          "modules": {
            "items": {
              "properties": {
                "brand": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "code": {
                  "type": "string"
                },
                "pole": {
                  "type": "string"
                },
                "tier": {
                  "enum": [
                    "JUNIOR",
                    "SENIOR",
                    "EXPERT",
                    null
                  ],
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "title": {
                  "type": "string"
                }
              },
              "required": [
                "pole",
                "brand",
                "tier",
                "code",
                "title"
              ],
              "type": "object"
            },
            "type": "array"
          },
          "pole": {
            "enum": [
              "motors",
              "equipment",
              "all"
            ],
            "type": "string"
          },
          "year": {
            "type": "integer"
          }
        },
        "required": [
          "year",
          "pole",
          "catalog_available",
          "modules"
        ],
        "type": "object"
      }
    },
    "securitySchemes": {
      "AnalyticsKey": {
        "in": "header",
        "name": "X-Analytics-Key",
        "type": "apiKey"
      },
      "CatalogWriteKey": {
        "in": "header",
        "name": "X-Catalog-Write-Key",
        "type": "apiKey"
      }
    }
  },
  "info": {
    "description": "Agrégats de service à service lus par cfao-core (tableau de bord super admin) et cfao-planning (clé de répartition).",
    "title": "CFAO Needs Analytics",
    "version": "1.3.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/needs/analytics/allocations-per-branch": {
      "get": {
        "operationId": "allocationsPerBranch",
        "parameters": [
          {
            "description": "Année de campagne. Défaut : année en cours.",
            "in": "query",
            "name": "year",
            "required": false,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AllocationsPerBranch"
                }
              }
            },
            "description": "Agrégat."
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "`year` n'est pas un entier."
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Clé `X-Analytics-Key` absente ou invalide (DRF sans authentificateur : 403)."
          }
        },
        "summary": "Places allouées par pays."
      }
    },
    "/api/v1/needs/analytics/catalog-level": {
      "post": {
        "operationId": "updateCatalogLevel",
        "parameters": [],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CatalogLevelUpdate"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CatalogLevelResult"
                }
              }
            },
            "description": "Niveau enregistré."
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            },
            "description": "Corps invalide, ou libellé absent du barème de la marque."
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            },
            "description": "Clé `X-Catalog-Write-Key` absente ou invalide."
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            },
            "description": "Ligne de catalogue inconnue."
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            },
            "description": "`expected` n'est plus à jour : `current` donne la valeur en base."
          }
        },
        "security": [
          {
            "CatalogWriteKey": []
          }
        ],
        "summary": "Corrige le niveau d'un module (cfao-planning, clé X-Catalog-Write-Key)."
      }
    },
    "/api/v1/needs/analytics/catalog-levels": {
      "get": {
        "operationId": "catalogLevels",
        "parameters": [
          {
            "description": "Année de campagne. Défaut : année en cours.",
            "in": "query",
            "name": "year",
            "required": false,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CatalogLevels"
                }
              }
            },
            "description": "Agrégat."
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "`year` n'est pas un entier."
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Clé `X-Analytics-Key` absente ou invalide (DRF sans authentificateur : 403)."
          }
        },
        "summary": "Niveau de chaque module, dans le barème de sa marque (cfao-planning)."
      }
    },
    "/api/v1/needs/analytics/needs-by-branch-brand": {
      "get": {
        "operationId": "needsByBranchBrand",
        "parameters": [
          {
            "description": "Pôle. Valeur inconnue traitée comme `all`.",
            "in": "query",
            "name": "pole",
            "required": false,
            "schema": {
              "enum": [
                "equipment",
                "motors",
                "all"
              ],
              "type": "string"
            }
          },
          {
            "description": "Année de campagne. Défaut : année en cours.",
            "in": "query",
            "name": "year",
            "required": false,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NeedsByBranchBrand"
                }
              }
            },
            "description": "Agrégat."
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "`year` n'est pas un entier."
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Clé `X-Analytics-Key` absente ou invalide (DRF sans authentificateur : 403)."
          }
        },
        "summary": "Besoins et techniciens par pays et marque (cfao-planning)."
      }
    },
    "/api/v1/needs/analytics/scheduled-trainings": {
      "get": {
        "operationId": "scheduledTrainings",
        "parameters": [
          {
            "description": "Année de campagne. Défaut : année en cours.",
            "in": "query",
            "name": "year",
            "required": false,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ScheduledTrainings"
                }
              }
            },
            "description": "Agrégat."
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "`year` n'est pas un entier."
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Clé `X-Analytics-Key` absente ou invalide (DRF sans authentificateur : 403)."
          }
        },
        "summary": "Sessions programmées."
      }
    },
    "/api/v1/needs/analytics/total-technicians": {
      "get": {
        "operationId": "totalTechnicians",
        "parameters": [
          {
            "description": "Pôle. Valeur inconnue traitée comme `all`.",
            "in": "query",
            "name": "bu",
            "required": false,
            "schema": {
              "enum": [
                "equipment",
                "motors",
                "all"
              ],
              "type": "string"
            }
          },
          {
            "description": "Année de campagne. Défaut : année en cours.",
            "in": "query",
            "name": "year",
            "required": false,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TotalTechnicians"
                }
              }
            },
            "description": "Agrégat."
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "`year` n'est pas un entier."
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Clé `X-Analytics-Key` absente ou invalide (DRF sans authentificateur : 403)."
          }
        },
        "summary": "Techniciens par pôle (Clé de Répartition)."
      }
    },
    "/api/v1/needs/analytics/unchosen-modules": {
      "get": {
        "operationId": "unchosenModules",
        "parameters": [
          {
            "description": "Pôle. Valeur inconnue traitée comme `all`.",
            "in": "query",
            "name": "pole",
            "required": false,
            "schema": {
              "enum": [
                "equipment",
                "motors",
                "all"
              ],
              "type": "string"
            }
          },
          {
            "description": "Année de campagne. Défaut : année en cours.",
            "in": "query",
            "name": "year",
            "required": false,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UnchosenModules"
                }
              }
            },
            "description": "Agrégat."
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "`year` n'est pas un entier."
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Clé `X-Analytics-Key` absente ou invalide (DRF sans authentificateur : 403)."
          }
        },
        "summary": "Modules du catalogue sans aucune demande validée (cfao-planning)."
      }
    }
  },
  "security": [
    {
      "AnalyticsKey": []
    }
  ]
}
