# Client public OIDC (PKCE) — aucun secret ici, par construction.
# Par défaut (vide) : utilise window.location.origin + "/realms/cfao-needs" (same-origin via gateway).
# Décommenter si développement local Vite isolé (port 5174) directement sur Keycloak (port 8081).
# VITE_OIDC_ISSUER=http://localhost:8081/realms/cfao-needs
VITE_OIDC_ISSUER=
VITE_OIDC_CLIENT_ID=needs-web
VITE_API_BASE=/api/v1/needs
