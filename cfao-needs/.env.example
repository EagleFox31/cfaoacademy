# Copier en .env et remplir. AUCUNE valeur par défaut sur les secrets :
# le service refuse de démarrer sans (interdit n° 3 de l'audit Academix).
# Ce fichier documente la FORME des variables, jamais des secrets réels.

# ── Secrets obligatoires ─────────────────────────────────────────────────────
NEEDS_SECRET_KEY=             # openssl rand -base64 48
NEEDS_DB_PASSWORD=
KC_DB_PASSWORD=
KC_ADMIN_PASSWORD=
NEEDS_DEMO_PASSWORD=       # comptes de recette du realm — poste local uniquement

# ── Mode de déploiement ──────────────────────────────────────────────────────
# standalone : Keycloak + Cerbos embarqués (défaut)
# integrated : ceux de la plateforme — ne change QUE ces variables, pas le code
NEEDS_DEPLOYMENT_MODE=standalone

# ── Ports ────────────────────────────────────────────────────────────────────
NEEDS_PORT=8080
KC_PORT=8081

# ── OIDC ─────────────────────────────────────────────────────────────────────
# docker-compose.yml (standalone) : laisser vide, le Keycloak embarqué sert.
# docker-compose.prod.yml : Keycloak commun, OIDC_ISSUER obligatoire.
#   OIDC_ISSUER=https://academy-server.shares.zrok.io/auth/realms/cfao
#   OIDC_AUDIENCE=cfao-needs-api      (défaut de la prod)
#   NEEDS_OIDC_CLIENT_ID=cfao-needs-web (défaut de la prod ; needs-web en standalone)
#   NEEDS_BIND=127.0.0.1              (cfao-edge seule entrée)
OIDC_JWKS_URL=
OIDC_ISSUER=
# Vide : défaut du fichier compose (needs-web en standalone, cfao-needs-api en
# prod). Une valeur ici s'impose aux deux et casse l'autre mode.
OIDC_AUDIENCE=
# Émetteurs supplémentaires, correspondance exacte : « émetteur=url-jwks;… »
# (un même realm vu par deux hôtes = deux entrées).
OIDC_TRUSTED_ISSUERS=

# ── Emailing ─────────────────────────────────────────────────────────────────
# Domaines considérés comme INTERNES : seuls eux peuvent recevoir un envoi
# automatique. Tout le reste passe par l'écran « À envoyer ».
NEEDS_INTERNAL_DOMAINS=cfao.com
NEEDS_TEAM_RECIPIENTS=academy@cfao.com
NEEDS_EMAIL_BACKEND=console       # console | smtp
NEEDS_SMTP_HOST=
NEEDS_SMTP_PORT=25
NEEDS_EMAIL_FROM=CFAO Academy <no-reply@cfao.com>

# ── URLs publiques ───────────────────────────────────────────────────────────
NEEDS_PUBLIC_BASE_URL=http://localhost:8080
NEEDS_CORS_ORIGINS=http://localhost:8080
