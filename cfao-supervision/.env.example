# Poste de développement (recette 8088) : copier en .env, jamais commité.
# Secrets : `python -c "import secrets; print(secrets.token_urlsafe(48))"`.
SUPERVISION_SECRET_KEY=
SUPERVISION_DB_PASSWORD=
# Émetteur vu par le navigateur = clés lues depuis le conteneur.
OIDC_TRUSTED_ISSUERS=http://localhost:8088/auth/realms/cfao=http://host.docker.internal:8088/auth/realms/cfao/protocol/openid-connect/certs
