# Modèle du .env de /srv/apps/cfao-supervision (fichier réel en 600, hors dépôt).
# Secrets : `openssl rand -base64 48`, générés sur le serveur.
SUPERVISION_VERSION=v0.1.0
SUPERVISION_DB_PASSWORD=
SUPERVISION_SECRET_KEY=
SUPERVISION_ALLOWED_HOSTS=academy-portail.shares.zrok.io,academy-server.shares.zrok.io,localhost,127.0.0.1,supervision-api
OIDC_ISSUER=https://academy-server.shares.zrok.io/auth/realms/cfao
# Même valeur que CFAO_SUPERVISION_COLLECTOR_SECRET dans le .env de cfao-identity.
KEYCLOAK_COLLECTOR_SECRET=
# Groupe propriétaire du socket Docker : `stat -c %g /var/run/docker.sock`.
DOCKER_GID=988
SUPERVISION_PORT=8097
