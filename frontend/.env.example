# MEDACAP — tests compétence live (Mesure)
# Serveur QCM : http://10.68.0.7/medacap (entreprise) ou http://localhost/medacap (local)
VITE_MEDACAP_URL=http://10.68.0.7/medacap

# Optionnel : API JSON sur un autre hôte (ex. WAMP local)
# VITE_MEDACAP_API_URL=http://localhost/medacap
#
# Mongo (WAMP api/config.local.php) — résolution auto :
#   dev  : 127.0.0.1 puis 10.68.0.7 si local down
#   prod : 10.68.0.7 uniquement (env => prod)

# Clé partagée avec views/measure/api/config.local.php
VITE_MEDACAP_BRIDGE_KEY=demo-cfao-portal
