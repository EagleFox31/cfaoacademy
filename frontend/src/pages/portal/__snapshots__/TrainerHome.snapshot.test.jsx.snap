exports[`portail du formateur : rendu figé > avec sessions à venir (fr) 1`] = `"<main class="portal-page"><div></div><section id="comptes-rendus"><div class="container" style="padding: 16px 32px;"><div class="portal-section-head"><p class="portal-section-eyebrow">Après chaque session</p><h2 class="portal-section-title">Vos comptes rendus de sessions de formation</h2></div><div><div class="portal-card-anchor"><button class="pv-card" style="--pv-accent: #E3001B;" type="button"><div class="pv-card-media"><div class="pv-card-img has-flou" style="--img-flou: url('data:image/webp;base64,UklGRmwAAABXRUJQVlA4IGAAAAAQAgCdASoNABAAA4BaJYwCsAEDtylxou6gAM4avXAcl6XBKtD/7UPn5HzjNbNKNJVTQ1VHkec2EwBuvwjDLC1vhXF0m3zHjVReYNbHeBMRi7zXCRr+MXjt30NjRtk5AAA=');"><img src="/assets/_r/publics/process-sav-960.webp" srcset="/assets/_r/publics/process-sav-480.webp 480w, /assets/_r/publics/process-sav-960.webp 960w" sizes="(max-width: 640px) 100vw, (max-width: 1100px) 50vw, 420px" width="1024" height="1280" alt="" loading="lazy" decoding="async"></div><span class="pv-card-hover-hint" role="tooltip">Rédiger un compte rendu</span></div><div class="pv-card-body"><div class="kicker"><span class="portal-status-chip progress">Nouveau</span></div><h3 class="clamp-lines" style="--clamp-lines: 3;">Rédiger un compte rendu</h3><div class="meta">Choisissez une session de votre planning, ou saisissez-la vous-même si elle n’y figure pas.</div><div class="pv-card-cta"><span class="pv-cta-link">Commencer <span class="arrow">→</span></span></div><span class="corner">↗</span></div></button></div><div class="portal-card-anchor"><button class="pv-card" type="button"><div class="pv-card-media"><div class="pv-card-img has-flou" style="--img-flou: url('data:image/webp;base64,UklGRmwAAABXRUJQVlA4IGAAAAAQAgCdASoNABAAA4BaJYwCsAEDtylxou6gAM4avXAcl6XBKtD/7UPn5HzjNbNKNJVTQ1VHkec2EwBuvwjDLC1vhXF0m3zHjVReYNbHeBMRi7zXCRr+MXjt30NjRtk5AAA=');"><img src="/assets/_r/publics/process-sav-960.webp" srcset="/assets/_r/publics/process-