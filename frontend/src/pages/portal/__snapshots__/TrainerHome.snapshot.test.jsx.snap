exports[`portail du formateur : rendu figé > sans session à venir (pt) 1`] = `"<main class="portal-page"><div></div><section id="comptes-rendus"><div class="container" style="padding: 16px 32px;"><div class="portal-section-head"><p class="portal-section-eyebrow">Após cada sessão</p><h2 class="portal-section-title">Os seus relatórios de sessões de formação</h2></div><div><div class="portal-card-anchor"><button class="pv-card" style="--pv-accent: #E3001B;" type="button"><div class="pv-card-media"><div class="pv-card-img has-flou" style="--img-flou: url('data:image/webp;base64,UklGRmwAAABXRUJQVlA4IGAAAAAQAgCdASoNABAAA4BaJYwCsAEDtylxou6gAM4avXAcl6XBKtD/7UPn5HzjNbNKNJVTQ1VHkec2EwBuvwjDLC1vhXF0m3zHjVReYNbHeBMRi7zXCRr+MXjt30NjRtk5AAA=');"><img src="/assets/_r/publics/process-sav-960.webp" srcset="/assets/_r/publics/process-sav-480.webp 480w, /assets/_r/publics/process-sav-960.webp 960w" sizes="(max-width: 640px) 100vw, (max-width: 1100px) 50vw, 420px" width="1024" height="1280" alt="" loading="lazy" decoding="async"></div><span class="pv-card-hover-hint" role="tooltip">Redigir um relatório</span></div><div class="pv-card-body"><div class="kicker"><span class="portal-status-chip progress">Novo</span></div><h3 class="clamp-lines" style="--clamp-lines: 3;">Redigir um relatório</h3><div class="meta">Escolha uma sessão do seu planeamento, ou introduza-a se não estiver na lista.</div><div class="pv-card-cta"><span class="pv-cta-link">Começar <span class="arrow">→</span></span></div><span class="corner">↗</span></div></button></div><div class="portal-card-anchor"><button class="pv-card" type="button"><div class="pv-card-media"><div class="pv-card-img has-flou" style="--img-flou: url('data:image/webp;base64,UklGRmwAAABXRUJQVlA4IGAAAAAQAgCdASoNABAAA4BaJYwCsAEDtylxou6gAM4avXAcl6XBKtD/7UPn5HzjNbNKNJVTQ1VHkec2EwBuvwjDLC1vhXF0m3zHjVReYNbHeBMRi7zXCRr+MXjt30NjRtk5AAA=');"><img src="/assets/_r/publics/process-sav-960.webp" srcset="/assets/_r/publics/process-sav-480.webp 480w, /assets/_r/publics/process-sav-960.webp 960w" sizes="(max-width: 640px) 100vw, (max-width: 1100px) 50vw, 420px" width="1024" height="1280" alt="" loading="lazy" decoding="async"></div><span class="pv-card-hover-hint" role="tooltip">Escolher um relatório a terminar</span></div><div class="pv-card-body"><div class="kicker"><span class="portal-status-chip todo">Iniciados</span></div><h3 class="clamp-lines" style="--clamp-lines: 3;">Retomar um relatório</h3><div class="meta">Termine os relatórios que começou, a partir de qualquer computador.</div><div class="pv-card-cta"><span class="pv-cta-link">Retomar <span class="arrow">→</span></span></div><span class="corner">↗</span></div></button></div><div class="portal-card-anchor"><button class="pv-card" type="button"><div class="pv-card-media"><div class="pv-card-img has-flou" style="--img-flou: url('data:image/webp;base64,UklGRoAAAABXRUJQVlA4IHQAAAAQAgCdASoQAAwAA4BaJQBOgB7H5I3RCUgAAP7nWGXRE0tcU2OtQFeIUf1j5YH4bxQfWakQsl+VIHvb4B5VMsNfHWxO5akpI+xEq/uPs1/Ra9Qzah6+AZt3OsGjEv2WVUpuVkPTNLzTABbV8T+cr25Ah6QAAA==');"><img src="/assets/_r/img_cards/certification-960.webp" srcset="/assets/_r/img_cards/certification-480.webp 480w, /assets/_r/img_cards/certification-960.webp 960w" sizes="(max-width: 640px) 100vw, (max-width: 1100px) 50vw, 420px" width="1448" height="1086" alt="" loading="lazy" decoding="async"></div><span class="pv-card-hover-hint" role="tooltip">Ver os meus relatórios concluídos</span></div><div class="pv-card-body"><div class="kicker"><span class="portal-status-chip done">Concluídos</span></div><h3 class="clamp-lines" style="--clamp-lines: 3;">Relatórios concluídos</h3><div class="meta">Releia os seus relatórios finalizados, sessão a sessão.</div><div class="pv-card-cta"><span class="pv-cta-link">Ver os meus relatórios <span class="arrow">→</span></span></div><span class="corner">↗</span></div></button></div></div></div></section><section id="formations"><div class="container" style="padding: 16px 32px;"><div class="portal-section-head"><p class="portal-section-eyebrow">O que ensina</p><h2 class="portal-section-title">Formações a ministrar</h2></div><div><div class="portal-card-anchor"><div class="pv-card"><div class="pv-card-media"><div class="pv-card-img portal-construction-media"><svg class="portal-construction-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 12-8.373 8.373a1 1 0 1 1-3-3L12 9"></path><path d="m18 15 4-4"></path><path d="m21.5 11.5-1.914-1.914A2 2 0 0 1 19 8.172V7l-2.26-2.26a6 6 0 0 0-4.202-1.756L9 2.96l.92.82A6.18 6.18 0 0 1 12 8.4V10l2 2h1.172a2 2 0 0 1 1.414.586L18.5 14.5"></path></svg><span class="portal-construction-label">Funcionalidade em construção</span><span class="portal-construction-tape" aria-hidden="true"></span></div></div><div class="pv-card-body"><div class="kicker"><span class="portal-status-chip todo">A seguir</span></div><h3 class="clamp-lines" style="--clamp-lines: 3;">As suas formações a ministrar</h3><div class="meta">Os módulos que anima, por marca e por nível, com os respetivos suportes.</div></div></div></div></div></div></section><section id="competences"><div class="container" style="padding: 16px 32px;"><div class="portal-section-head"><p class="portal-section-eyebrow">Medição de competências</p><h2 class="portal-section-title">Resultados dos técnicos</h2></div><div><div class="portal-card-anchor"><div class="pv-card"><div class="pv-card-media"><div class="pv-card-img portal-construction-media"><svg class="portal-construction-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 12-8.373 8.373a1 1 0 1 1-3-3L12 9"></path><path d="m18 15 4-4"></path><path d="m21.5 11.5-1.914-1.914A2 2 0 0 1 19 8.172V7l-2.26-2.26a6 6 0 0 0-4.202-1.756L9 2.96l.92.82A6.18 6.18 0 0 1 12 8.4V10l2 2h1.172a2 2 0 0 1 1.414.586L18.5 14.5"></path></svg><span class="portal-construction-label">Funcionalidade em construção</span><span class="portal-construction-tape" aria-hidden="true"></span></div></div><div class="pv-card-body"><div class="kicker"><span class="portal-status-chip todo">A seguir</span></div><h3 class="clamp-lines" style="--clamp-lines: 3;">Resultados Júnior</h3><div class="meta">Nível Manutenção, todas as filiais, nas suas marcas.</div></div></div></div><div class="portal-card-anchor"><div class="pv-card"><div class="pv-card-media"><div class="pv-card-img portal-construction-media"><svg class="portal-construction-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 12-8.373 8.373a1 1 0 1 1-3-3L12 9"></path><path d="m18 15 4-4"></path><path d="m21.5 11.5-1.914-1.914A2 2 0 0 1 19 8.172V7l-2.26-2.26a6 6 0 0 0-4.202-1.756L9 2.96l.92.82A6.18 6.18 0 0 1 12 8.4V10l2 2h1.172a2 2 0 0 1 1.414.586L18.5 14.5"></path></svg><span class="portal-construction-label">Funcionalidade em construção</span><span class="portal-construction-tape" aria-hidden="true"></span></div></div><div class="pv-card-body"><div class="kicker"><span class="portal-status-chip todo">A seguir</span></div><h3 class="clamp-lines" style="--clamp-lines: 3;">Resultados Sénior</h3><div class="meta">Nível Reparação, todas as filiais, nas suas marcas.</div></div></div></div><div class="portal-card-anchor"><div class="pv-card"><div class="pv-card-media"><div class="pv-card-img portal-construction-media"><svg class="portal-construction-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 12-8.373 8.373a1 1 0 1 1-3-3L12 9"></path><path d="m18 15 4-4"></path><path d="m21.5 11.5-1.914-1.914A2 2 0 0 1 19 8.172V7l-2.26-2.26a6 6 0 0 0-4.202-1.756L9 2.96l.92.82A6.18 6.18 0 0 1 12 8.4V10l2 2h1.172a2 2 0 0 1 1.414.586L18.5 14.5"></path></svg><span class="portal-construction-label">Funcionalidade em construção</span><span class="portal-construction-tape" aria-hidden="true"></span></div></div><div class="pv-card-body"><div class="kicker"><span class="portal-status-chip todo">A seguir</span></div><h3 class="clamp-lines" style="--clamp-lines: 3;">Resultados Expert</h3><div class="meta">Nível Diagnóstico, todas as filiais, nas suas marcas.</div></div></div></div></div></div></section><section id="certifs"><div class="container" style="padding: 16px 32px;"><div class="portal-section-head"><p class="portal-section-eyebrow">Certificação</p><h2 class="portal-section-title">Certificações dos seus formandos</h2></div><div><div class="portal-card-anchor"><div class="pv-card"><div class="pv-card-media"><div class="pv-card-img portal-construction-media"><svg class="portal-construction-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 12-8.373 8.373a1 1 0 1 1-3-3L12 9"></path><path d="m18 15 4-4"></path><path d="m21.5 11.5-1.914-1.914A2 2 0 0 1 19 8.172V7l-2.26-2.26a6 6 0 0 0-4.202-1.756L9 2.96l.92.82A6.18 6.18 0 0 1 12 8.4V10l2 2h1.172a2 2 0 0 1 1.414.586L18.5 14.5"></path></svg><span class="portal-construction-label">Funcionalidade em construção</span><span class="portal-construction-tape" aria-hidden="true"></span></div></div><div class="pv-card-body"><div class="kicker"><span class="portal-status-chip todo">A seguir</span></div><h3 class="clamp-lines" style="--clamp-lines: 3;">Técnicos certificados após as suas sessões</h3><div class="meta">Por nível e por marca: quem obteve a certificação após as suas formações.</div></div></div></div></div></div></section><section id="assistance"><div class="container" style="padding: 16px 32px;"><div class="portal-section-head"><p class="portal-section-eyebrow" style="display: flex; align-items: center; gap: 6px; flex-wrap: wrap;"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="flex-shrink: 0;"><circle cx="12" cy="12" r="10"></circle><path d="m4.93 4.93 4.24 4.24"></path><path d="m14.83 9.17 4.24-4.24"></path><path d="m14.83 14.83 4.24 4.24"></path><path d="m9.17 14.83-4.24 4.24"></path><circle cx="12" cy="12" r="4"></circle></svg>Apoio Academy</p><h2 class="portal-section-title">Assistência aos técnicos</h2></div><div class="portal-plan-status-filter sessions-brand-filter" role="group" aria-label="Filtrar os tickets oficina por estado"><span class="sessions-brand-filter-lbl">Filtrar</span><div class="sessions-brand-chips"><button type="button" class="chip active" aria-pressed="true">Todos<span class="tab-count">0</span></button><button type="button" class="chip" aria-pressed="false">Ticket aberto<span class="tab-count">0</span></button><button type="button" class="chip" aria-pressed="false">Ticket em curso<span class="tab-count">0</span></button><button type="button" class="chip" aria-pressed="false">Ticket resolvido<span class="tab-count">0</span></button></div></div><div class="portal-plan-filter-empty" role="status">Nenhum pedido nas suas marcas.</div><div></div></div></section></main>"`;
