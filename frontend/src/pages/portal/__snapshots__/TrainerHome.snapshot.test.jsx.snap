exports[`portail du formateur : rendu figé > sans session à venir (en) 1`] = `"<main class="portal-page"><div></div><section id="comptes-rendus"><div class="container" style="padding: 16px 32px;"><div class="portal-section-head"><p class="portal-section-eyebrow">After each session</p><h2 class="portal-section-title">Your training session reports</h2></div><div><div class="portal-card-anchor"><button class="pv-card" style="--pv-accent: #E3001B;" type="button"><div class="pv-card-media"><div class="pv-card-img has-flou" style="--img-flou: url('data:image/webp;base64,UklGRmwAAABXRUJQVlA4IGAAAAAQAgCdASoNABAAA4BaJYwCsAEDtylxou6gAM4avXAcl6XBKtD/7UPn5HzjNbNKNJVTQ1VHkec2EwBuvwjDLC1vhXF0m3zHjVReYNbHeBMRi7zXCRr+MXjt30NjRtk5AAA=');"><img src="/assets/_r/publics/process-sav-960.webp" srcset="/assets/_r/publics/process-sav-480.webp 480w, /assets/_r/publics/process-sav-960.webp 960w" sizes="(max-width: 640px) 100vw, (max-width: 1100px) 50vw, 420px" width="1024" height="1280" alt="" loading="lazy" decoding="async"></div><span class="pv-card-hover-hint" role="tooltip">Write a report</span></div><div class="pv-card-body"><div class="kicker"><span class="portal-status-chip progress">New</span></div><h3 class="clamp-lines" style="--clamp-lines: 3;">Write a report</h3><div class="meta">Pick a session from your schedule, or enter it yourself if it is not listed.</div><div class="pv-card-cta"><span class="pv-cta-link">Start <span class="arrow">→</span></span></div><span class="corner">↗</span></div></button></div><div class="portal-card-anchor"><button class="pv-card" type="button"><div class="pv-card-media"><div class="pv-card-img has-flou" style="--img-flou: url('data:image/webp;base64,UklGRmwAAABXRUJQVlA4IGAAAAAQAgCdASoNABAAA4BaJYwCsAEDtylxou6gAM4avXAcl6XBKtD/7UPn5HzjNbNKNJVTQ1VHkec2EwBuvwjDLC1vhXF0m3zHjVReYNbHeBMRi7zXCRr+MXjt30NjRtk5AAA=');"><img src="/assets/_r/publics/process-sav-960.webp" srcset="/assets/_r/publics/process-sav-480.webp 480w, /assets/_r/publics/process-sav-960.webp 960w" sizes="(max-width: 640px) 100vw, (max-width: 1100px) 50vw, 420px" width="1024" height="1280" alt="" loading="lazy" decoding="async"></div><span class="pv-card-hover-hint" role="tooltip">Choose a report to finish</span></div><div class="pv-card-body"><div class="kicker"><span class="portal-status-chip todo">Started</span></div><h3 class="clamp-lines" style="--clamp-lines: 3;">Resume a report</h3><div class="meta">Finish the reports you started, from any computer.</div><div class="pv-card-cta"><span class="pv-cta-link">Resume <span class="arrow">→</span></span></div><span class="corner">↗</span></div></button></div><div class="portal-card-anchor"><button class="pv-card" type="button"><div class="pv-card-media"><div class="pv-card-img has-flou" style="--img-flou: url('data:image/webp;base64,UklGRoAAAABXRUJQVlA4IHQAAAAQAgCdASoQAAwAA4BaJQBOgB7H5I3RCUgAAP7nWGXRE0tcU2OtQFeIUf1j5YH4bxQfWakQsl+VIHvb4B5VMsNfHWxO5akpI+xEq/uPs1/Ra9Qzah6+AZt3OsGjEv2WVUpuVkPTNLzTABbV8T+cr25Ah6QAAA==');"><img src="/assets/_r/img_cards/certification-960.webp" srcset="/assets/_r/img_cards/certification-480.webp 480w, /assets/_r/img_cards/certification-960.webp 960w" sizes="(max-width: 640px) 100vw, (max-width: 1100px) 50vw, 420px" width="1448" height="1086" alt="" loading="lazy" decoding="async"></div><span class="pv-card-hover-hint" role="tooltip">See my completed reports</span></div><div class="pv-card-body"><div class="kicker"><span class="portal-status-chip done">Completed</span></div><h3 class="clamp-lines" style="--clamp-lines: 3;">Completed reports</h3><div class="meta">Read your finalised reports again, session by session.</div><div class="pv-card-cta"><span class="pv-cta-link">See my reports <span class="arrow">→</span></span></div><span class="corner">↗</span></div></button></div></div></div></section><section id="formations"><div class="container" style="padding: 16px 32px;"><div class="portal-section-head"><p class="portal-section-eyebrow">What you teach</p><h2 class="portal-secti