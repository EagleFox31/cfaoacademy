# Modèle du .env de /srv/apps/cfao-portail (aucun secret : tout est public côté navigateur).
PORTAIL_VERSION=v0.1.0
PORTAIL_OIDC_ISSUER=https://academy-server.shares.zrok.io/auth/realms/cfao
PORTAIL_OIDC_CLIENT_ID=cfao-portail-web
# Applications : chemin sur la même adresse que le portail (une adresse, des chemins).
PORTAIL_CR_URL=/cr
# Vide : cartes de compétences MEDACAP inactives (serveur MEDACAP non joignable).
PORTAIL_MEDACAP_URL=
PORTAIL_PORT=8095
# Application « Recueil des besoins ». Vide : carte « en construction ».
PORTAIL_NEEDS_URL=/besoins
