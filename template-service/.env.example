# ==============================================================================
# Configuration Environnement — CFAO Academy Service Template
# ==============================================================================

# Mode de déploiement ('standalone' pour dev local autonome, 'integrated' sur la plateforme)
DEPLOYMENT_MODE=standalone

# Sécurité Django
SECRET_KEY=dev-insecure-secret-key-change-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,service-api

# Base de données PostgreSQL locale
DB_NAME=service_db
DB_USER=service_user
DB_PASSWORD=local_dev_password_change_me
DB_HOST=service-db
DB_PORT=5432

# Ports d'exposition locale
API_PORT=8000
CERBOS_PORT=3592

# Autorisation (PDP Cerbos)
CERBOS_HTTP=http://service-cerbos:3592

# Authentification Keycloak OIDC (optionnel en standalone, requis en integrated)
OIDC_ISSUER=http://localhost:8081/realms/cfao
OIDC_AUDIENCE=cfao-platform

# URL de l'API centrale de la plateforme CFAO Core (utilisé en mode integrated)
PLATFORM_CORE_URL=http://localhost:8000
