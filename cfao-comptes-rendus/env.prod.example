# Comptes rendus formateur - .env du serveur (docker-compose.prod.yml).
# Copier en .env SEULEMENT pour fixer des valeurs : deploy.sh / deploy.ps1
# generent SECRET_KEY et POSTGRES_PASSWORD s'ils sont absents, et deduisent
# le reste de l'adresse LAN. Ne jamais versionner le .env.

# ── Secrets (laisser vides : generes au premier deploiement, puis NE PLUS LES CHANGER) ──
# Mot de passe saisi a la main : sans @ : / # ? %
SECRET_KEY=
POSTGRES_PASSWORD=

# ── Version des images antifragile237/cfao-comptes-rendus-* ──
CR_VERSION=v0.3.0

# ── Exposition (par defaut : http://<IP LAN>:8090) ──
#CR_PORT=8090
#CR_BIND=0.0.0.0            # 127.0.0.1 si un proxy TLS est devant
#CR_LAN_HOST=10.68.0.7      # si la detection automatique se trompe
#CR_PUBLIC_URL=https://comptes-rendus.example
# Derives de CR_PUBLIC_URL si absents :
#ORIGINES_AUTORISEES=https://comptes-rendus.example
#ALLOWED_HOSTS=comptes-rendus.example
#COOKIE_SECURE=True         # automatique : True si CR_PUBLIC_URL est en https

# ── Profils des formateurs (deposes par reprise.sh / reprise.ps1) ──
#PROFILS_LOCAUX=/donnees/profils-locaux.json
