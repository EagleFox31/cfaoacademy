# Service des comptes rendus — variables d'environnement (FORME uniquement, aucun secret reel).
# Copier en `.env` pour `docker compose up` dans ce dossier.

# standalone : profils fictifs, sans mot de passe, DEBUG=True obligatoire (poste de dev).
# integrated : jeton Keycloak verifie (JWKS) ; SECRET_KEY, OIDC_ISSUER et OIDC_JWKS_URL obligatoires.
DEPLOYMENT_MODE=standalone
DEBUG=True
SECRET_KEY=change-me
# Noms sous lesquels le service est appele (derriere la passerelle : son nom public).
ALLOWED_HOSTS=localhost,127.0.0.1

DB_NAME=comptes_rendus
DB_USER=comptes_rendus
DB_PASSWORD=change-me
API_PORT=5175

# Mode integre seulement.
OIDC_ISSUER=
OIDC_JWKS_URL=
# Audience attendue dans le jeton (client Keycloak du portail). Vide = non verifiee.
OIDC_AUDIENCE=
PLATFORM_CORE_URL=http://localhost:8000
