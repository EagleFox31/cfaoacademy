# Module comptes rendus — variables d'environnement (FORME uniquement, aucun secret reel).
# Copier en `.env` pour `docker compose up` dans ce dossier.
# Ce fichier brut (standalone, DEBUG=True) est reserve au POSTE DE DEV. Pour un
# usage reel : DEPLOYMENT_MODE=local, DEBUG=False, une vraie SECRET_KEY (voir README).

# Port de la passerelle (seul port publie) et adresse de liaison : 127.0.0.1 par
# defaut. Ne pas l'elargir sans reverse proxy TLS devant (voir README, « Exposer en interne »).
CR_PORT=8090
#CR_BIND=127.0.0.1

# Mode d'authentification (DEPLOYMENT_MODE) :
#   standalone : profils fictifs, sans mot de passe, DEBUG=True obligatoire (poste de dev).
#   local      : comptes a mot de passe, sans Keycloak (prod interne). Exige DEBUG=False,
#                une vraie SECRET_KEY et COMPTES_LOCAUX ; creer un compte avec
#                `docker compose exec api python manage.py mot_de_passe <identifiant>`.
#                L'identifiant doit exister dans PROFILS_LOCAUX (par defaut : profils fictifs
#                de l'image ; pour les vrais, deposer un fichier dans le volume /donnees).
#   integrated : jeton Keycloak de la plateforme verifie (JWKS) ; voir le bloc OIDC plus bas.
DEPLOYMENT_MODE=standalone
DEBUG=True
SECRET_KEY=change-me
# Mode local : base des empreintes de mots de passe (sur le volume du service).
#COMPTES_LOCAUX=/donnees/comptes.sqlite3
#PROFILS_LOCAUX=/donnees/profils-locaux.json

# Noms sous lesquels le service est appele (la passerelle transmet l'en-tete Host).
ALLOWED_HOSTS=localhost,127.0.0.1

# Cookie de session. Meme hote et ports differents = meme site : un nom propre au
# module evite la collision avec le cookie d'une autre application (le portail).
# SameSite=Lax ne protege pas contre une page d'un autre port du meme hote :
# les requetes qui ecrivent sont donc filtrees par origine (ORIGINES_AUTORISEES).
COOKIE_SESSION=cfao_cr_session
# True derriere HTTPS (le cookie n'est alors jamais envoye en clair).
COOKIE_SECURE=False
# Origines des pages autorisees a ecrire (POST/PUT/PATCH/DELETE) ; sans Origin ni
# Referer, une requete portant le cookie est refusee. A adapter si CR_PORT change
# ou si le module est servi sous un nom public (https://comptes-rendus.example).
ORIGINES_AUTORISEES=http://localhost:8090,http://127.0.0.1:8090,http://localhost:5176,http://127.0.0.1:5176

# Base PostgreSQL du module.
POSTGRES_DB=comptes_rendus
POSTGRES_USER=comptes_rendus
# Le mot de passe est insere tel quel dans l'URL de connexion (DATABASE_URL) :
# eviter les caracteres @ : / # ? % (ou les encoder en %40 %3A %2F %23 %3F %25).
POSTGRES_PASSWORD=change-me

# Mode integrated seulement (Keycloak de la plateforme, jamais un realm propre).
OIDC_ISSUER=
OIDC_JWKS_URL=
# Emetteurs supplementaires, correspondance exacte : « emetteur=url-jwks;... »
OIDC_TRUSTED_ISSUERS=
# Audience attendue dans le jeton (client Keycloak du portail). Obligatoire en mode integrated.
OIDC_AUDIENCE=
PLATFORM_CORE_URL=http://localhost:8000

# --- Production (docker-compose.prod.yml) ---
# Le compose de prod impose DEPLOYMENT_MODE=local et DEBUG=False ; il refuse de
# demarrer sans SECRET_KEY, ALLOWED_HOSTS, ORIGINES_AUTORISEES, COOKIE_SECURE et
# POSTGRES_PASSWORD. Exemple :
#   SECRET_KEY=<python -c "import secrets; print(secrets.token_urlsafe(50))">
#   ALLOWED_HOSTS=comptes-rendus.example
#   ORIGINES_AUTORISEES=https://comptes-rendus.example
#   COOKIE_SECURE=True
#   CR_BIND=127.0.0.1        # proxy TLS du serveur devant la passerelle
#   CR_VERSION=v0.3.0        # tag des images antifragile237/cfao-comptes-rendus-*
