# Modèle du .env de /srv/apps/cfao-planning (fichier réel en 600, hors dépôt).
# Secrets : `openssl rand -base64 48`, générés sur le serveur.
PLANNING_VERSION=v0.1.2
PLANNING_DB_PASSWORD=
PLANNING_SECRET_KEY=
PLANNING_ALLOWED_HOSTS=academy-portail.shares.zrok.io,academy-server.shares.zrok.io,localhost,127.0.0.1,planning-api
# Origines HTTPS pour les requêtes à cookie (optionnel), ex. https://<ip-du-serveur>:<port>
# PLANNING_CSRF_TRUSTED_ORIGINS=
OIDC_ISSUER=https://academy-server.shares.zrok.io/auth/realms/cfao
# Mêmes valeurs que dans le .env de cfao-needs.
NEEDS_ANALYTICS_KEY=
NEEDS_SNAPSHOT_INBOUND_KEY=
NEEDS_CATALOG_WRITE_KEY=
# Même valeur que dans le .env du module Comptes rendus (contrat cr-sessions).
CR_SESSIONS_KEY=
# Classeurs chargés au démarrage (lecture seule) : partage de l'équipe, et dossier
# de compléments sur le serveur (ex. clés de répartition absentes du partage).
PLANNING_SHARE_DIR=/srv/partage/users/academy
PLANNING_EXTRA_WORKBOOKS_DIR=./classeurs
# Exercices clos, gelés après chargement (espaces ou virgules).
PLANNING_CLOSED_YEARS=2026
